# Copy to .env.local and fill in. Never commit .env.local.
# Names and purpose: SPEC.md §21.1. Neon and Blob values come from
# `vercel env pull .env.local` once those integrations are connected.

# Neon Postgres (set by the Vercel Neon integration)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Vercel Blob (set by the Vercel Blob integration)
BLOB_READ_WRITE_TOKEN=

# Admin auth: base64 of the bcrypt hash printed by `pnpm hash-password`
ADMIN_PASSWORD_HASH=
# At least 32 random bytes, e.g. `openssl rand -base64 48`
SESSION_SECRET=
# Random string used to hash visitor IPs (never stored raw)
IP_HASH_SALT=

# Canonical site URL, e.g. https://your-project.vercel.app (only public var)
NEXT_PUBLIC_SITE_URL=

# Optional: contact-form email notifications via Resend
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# Optional: separate database for E2E tests (never the production DB)
DATABASE_URL_TEST=
